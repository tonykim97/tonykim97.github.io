@inproceedings{kim20252ksr,
  abbr              = {KSR},
  preview           = {kim20252ksr_preview.png},
  title             = {Deep Learning‑based Railroad Track Detection Image Segmentation Algorithm},
  author            = {Kim, Jeongwon and Lee, Seungmin and Lee*, Heesung},
  abstract          = {사전 학습된 모델을 새로운 데이터셋에서 활용하는 기존의 방법은 모델 가중치들을 미세조정하여 학습하는 방법이다. 하지만 특수한 도메인의 데이터 셋 학습이나 대규모 모델의 하위 계층의 수정이 필요한 작업에서 미세조정 방법은 효율적이지 않으며, 이를 극복하기 위한 새로운 접근 방식은 가중치를 동결시킨 모델을 활용하는 것이다. 본 연구에서는 대규모 데이터 셋으로 사전 학습된 영상 분할 모델들을 이용하여 선로를 분할하는 연구를 진행한다. 이를 통해 사전 학습된 모델들의 유용성과 철도 시스템에서의 활용 가능성에 대해 연구하고 이러한 모델들의 실제 적용 가능성에 대해서도 탐구하였다.},
  booktitle         = {Proceedings of the KSR Conference},
  year              = {2025},
  month             = {Oct},
  url               = {https://railway.or.kr},
  html              = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12888119},
  selected          = {true}
}


